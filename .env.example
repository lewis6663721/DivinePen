# ── 复制为 .env 后填写。.env 永不入库。────────────────────

# 数据库
# MySQL（生产/开发默认）：
DIVINEPEN_DB_URL=mysql://root:password@127.0.0.1:3306/divinepen
# 零配置回退（不配 DIVINEPEN_DB_URL 时自动使用）：
# DIVINEPEN_DB_URL=sqlite://./var/divinepen.sqlite3

# Redis（Celery broker / 续查调度 / 限流）
DIVINEPEN_REDIS_URL=redis://127.0.0.1:6379/0

# 服务
DIVINEPEN_HOST=127.0.0.1
DIVINEPEN_PORT=8801
DIVINEPEN_SECRET_KEY=change-me-to-a-random-32-byte-hex
DIVINEPEN_SESSION_MAX_AGE_HOURS=6

# 凭据加密密钥（Fernet，用于 dp_credential.api_key 落库加密）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIVINEPEN_CREDENTIAL_KEY=

# 首个注册账号自动成为管理员
DIVINEPEN_ALLOW_REGISTER=true

# 是否强制登录。本地开发默认 false（直接看页面）；上线必须 true
DIVINEPEN_AUTH_REQUIRED=false

# ── 供应商 API Key（可选；正式做法是在管理后台写入 dp_credential）──
# 仅用于本地脚本/测试；服务运行时应以数据库为准。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ── OSS（可选，不配则产物落本地目录）────────────────────
DIVINEPEN_OSS_ENABLED=false
DIVINEPEN_OSS_ENDPOINT=
DIVINEPEN_OSS_BUCKET=
DIVINEPEN_OSS_ACCESS_KEY_ID=
DIVINEPEN_OSS_ACCESS_KEY_SECRET=

# ── 产物本地目录 ────────────────────────────────────────
DIVINEPEN_MEDIA_ROOT=./media

# 默认关闭真实计费调用；生产环境由用户显式点击触发
DIVINEPEN_ALLOW_BILLED_CALLS=false
